PORT=3001
# MongoDB Connection String (MongoDB Atlas cluster or local mongodb://127.0.0.1:27017/online-polling)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/online-polling?retryWrites=true&w=majority

# Client frontend URL (e.g. http://localhost:5173 or https://online-polling-system-jade.vercel.app)
CLIENT_ORIGIN=http://localhost:5173

# Generate a unique random secret with at least 32 characters. Never commit the real value.
JWT_SECRET=replace_with_a_unique_random_secret_of_32_or_more_characters

# Optional Google Gemini integration; keep the API key on the backend only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
