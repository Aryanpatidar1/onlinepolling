PORT=3001
# MongoDB Connection String (MongoDB Atlas cluster or local mongodb://127.0.0.1:27017/online-polling)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/online-polling?retryWrites=true&w=majority

# Client frontend URL (e.g. http://localhost:5173 or https://online-polling-system-jade.vercel.app)
CLIENT_ORIGIN=http://localhost:5173

# Secret key used to sign and verify JWT tokens
JWT_SECRET=my_super_secret_jwt_key_online_polling_2025_secure_xyz

# AI Poll Copilot (OpenAI-compatible chat completions API)
# Keep the API key on the backend; never put it in a VITE_ variable.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
